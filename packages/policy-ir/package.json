{
  "name": "@warden/policy-ir",
  "version": "0.1.0",
  "description": "Warden Policy IR: typed rule vocabulary, trusted compiler, signed policy bundles",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema.json": "./schema/policy-ir.schema.json"
  },
  "bin": {
    "warden-policy": "./dist/cli.js"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "schema": "node dist/cli.js schema > schema/policy-ir.schema.json"
  },
  "dependencies": {
    "safe-regex2": "^5.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "fast-check": "^4.10.2"
  }
}
