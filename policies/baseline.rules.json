[
  {
    "id": "W-DESC-001",
    "version": 1,
    "description": "Hidden Unicode (zero-width, bidi, tag characters) in a tool description: classic tool-poisoning concealment.",
    "mode": "enforce",
    "severity": "critical",
    "action": {
      "type": "quarantine_tool",
      "message": "tool description hides characters"
    },
    "scope": {
      "channels": [
        "description"
      ]
    },
    "match": {
      "kind": "hiddenUnicode",
      "field": "text"
    },
    "owasp": [
      "MCP03",
      "ASI04"
    ],
    "provenance": {
      "author": "human",
      "note": "Invariant Labs tool-poisoning write-ups; ASCII smuggling via Unicode tags"
    }
  },
  {
    "id": "W-DESC-002",
    "version": 1,
    "description": "Tool description contains instructions aimed at the model rather than a description of the tool.",
    "mode": "enforce",
    "severity": "critical",
    "action": {
      "type": "quarantine_tool",
      "message": "tool description contains instructions to the model"
    },
    "scope": {
      "channels": [
        "description"
      ]
    },
    "match": {
      "any": [
        {
          "kind": "text",
          "field": "text",
          "op": "anyOf",
          "value": [
            "<important>",
            "</important>",
            "<instructions>",
            "<system>",
            "do not tell the user",
            "don't tell the user",
            "do not mention this",
            "without telling the user",
            "without informing the user",
            "the user must not know",
            "ignore previous instructions",
            "ignore all previous instructions",
            "disregard previous instructions",
            "this is very important",
            "otherwise the tool will not work",
            "or the application will crash",
            "you must also",
            "before using this tool, read",
            "before using this tool you must",
            "pass its content as",
            "as a side note",
            "concealed",
            "secretly"
          ]
        },
        {
          "kind": "text",
          "field": "text",
          "op": "regex",
          "value": "(?:send|forward|copy|upload|bcc|cc)[^.\\n]{0,60}(?:to|into)\\s+[a-z0-9._%+-]+@[a-z0-9.-]+"
        }
      ]
    },
    "owasp": [
      "MCP03",
      "ASI01",
      "ASI04"
    ],
    "provenance": {
      "author": "human",
      "note": "Patterns rebuilt from public MCP tool-poisoning PoCs (WhatsApp MCP, Invariant Labs)"
    }
  },
  {
    "id": "W-DESC-003",
    "version": 1,
    "description": "Tool description refers to another server's tools (cross-server shadowing).",
    "mode": "enforce",
    "severity": "high",
    "action": {
      "type": "quarantine_tool",
      "message": "tool description refers to other tools"
    },
    "scope": {
      "channels": [
        "description"
      ]
    },
    "match": {
      "kind": "toolRef",
      "field": "description"
    },
    "owasp": [
      "MCP03",
      "MCP09"
    ],
    "provenance": {
      "author": "human"
    }
  },
  {
    "id": "W-DESC-004",
    "version": 1,
    "description": "Tool description mentions sensitive local files or credential stores.",
    "mode": "enforce",
    "severity": "high",
    "action": {
      "type": "quarantine_tool",
      "message": "tool description references sensitive files"
    },
    "scope": {
      "channels": [
        "description"
      ]
    },
    "match": {
      "kind": "text",
      "field": "text",
      "op": "anyOf",
      "value": [
        "~/.ssh",
        "id_rsa",
        "id_ed25519",
        "/etc/passwd",
        "/etc/shadow",
        ".aws/credentials",
        "~/.cursor/mcp.json",
        "mcp.json",
        ".env file"
      ]
    },
    "owasp": [
      "MCP03",
      "MCP01"
    ],
    "provenance": {
      "author": "human"
    }
  },
  {
    "id": "W-DESC-005",
    "version": 1,
    "description": "Detection cascade scores the tool description as an injection.",
    "mode": "enforce",
    "severity": "high",
    "action": {
      "type": "quarantine_tool",
      "message": "detector flagged the tool description"
    },
    "scope": {
      "channels": [
        "description"
      ]
    },
    "match": {
      "kind": "detector",
      "layer": "max",
      "gte": 0.85
    },
    "owasp": [
      "MCP03"
    ],
    "provenance": {
      "author": "human"
    }
  },
  {
    "id": "W-ARG-001",
    "version": 1,
    "description": "Tool-call argument points at a private, loopback, link-local or cloud-metadata address (SSRF).",
    "mode": "enforce",
    "severity": "critical",
    "action": {
      "type": "block",
      "message": "the address is internal (possible SSRF)"
    },
    "scope": {
      "channels": [
        "arguments"
      ]
    },
    "match": {
      "kind": "url",
      "field": "args.**",
      "privateAddress": true
    },
    "owasp": [
      "ASI02",
      "MCP05"
    ],
    "provenance": {
      "author": "human"
    }
  },
  {
    "id": "W-ARG-002",
    "version": 1,
    "description": "Tool-call argument uses a non-web URL scheme (file, gopher, dict, ftp, ldap).",
    "mode": "enforce",
    "severity": "high",
    "action": {
      "type": "block",
      "message": "the URL scheme is not allowed"
    },
    "scope": {
      "channels": [
        "arguments"
      ]
    },
    "match": {
      "kind": "url",
      "field": "args.**",
      "schemeNotIn": [
        "http",
        "https",
        "mailto"
      ]
    },
    "owasp": [
      "ASI02",
      "MCP05"
    ],
    "provenance": {
      "author": "human"
    }
  },
  {
    "id": "W-ARG-003",
    "version": 1,
    "description": "A secret, credential or canary token is leaving through an outbound or high-risk tool.",
    "mode": "enforce",
    "severity": "critical",
    "action": {
      "type": "block",
      "message": "the call would send a secret or credential"
    },
    "scope": {
      "channels": [
        "arguments"
      ],
      "riskTiers": [
        "external_send",
        "financial_destructive"
      ]
    },
    "match": {
      "kind": "secret",
      "field": "args.**"
    },
    "owasp": [
      "MCP01",
      "ASI02",
      "MCP10"
    ],
    "provenance": {
      "author": "human"
    }
  },
  {
    "id": "W-ARG-004",
    "version": 1,
    "description": "Markdown image pointing outside the organisation with data in the URL: zero-click exfiltration (EchoLeak pattern).",
    "mode": "enforce",
    "severity": "critical",
    "action": {
      "type": "block",
      "message": "the content embeds an external image URL carrying data"
    },
    "scope": {
      "channels": [
        "arguments"
      ]
    },
    "match": {
      "kind": "url",
      "field": "args.**",
      "markdownImage": true,
      "hostNotIn": [
        "*.acme.example"
      ],
      "queryLengthGt": 0
    },
    "owasp": [
      "ASI01",
      "MCP10"
    ],
    "provenance": {
      "author": "human",
      "note": "EchoLeak CVE-2025-32711"
    }
  },
  {
    "id": "W-ARG-005",
    "version": 1,
    "description": "After reading untrusted content, a call sends a long query string to a host outside the organisation (exfiltration via URL).",
    "mode": "enforce",
    "severity": "high",
    "action": {
      "type": "block",
      "message": "the URL carries data to an outside host after untrusted content was read"
    },
    "scope": {
      "channels": [
        "arguments"
      ],
      "taint": "tainted",
      "riskTiers": [
        "external_send",
        "financial_destructive"
      ]
    },
    "match": {
      "kind": "url",
      "field": "args.**",
      "hostNotIn": [
        "*.acme.example"
      ],
      "queryLengthGt": 48
    },
    "owasp": [
      "ASI01",
      "MCP06",
      "MCP10"
    ],
    "provenance": {
      "author": "human"
    }
  },
  {
    "id": "W-TAINT-001",
    "version": 1,
    "description": "Tainted session: a recipient, destination or URL for a high-risk call is not traceable to the user's request or trusted data.",
    "mode": "enforce",
    "severity": "high",
    "action": {
      "type": "step_up",
      "message": "the destination did not come from the user's request"
    },
    "scope": {
      "channels": [
        "arguments"
      ],
      "taint": "tainted",
      "riskTiers": [
        "external_send",
        "financial_destructive"
      ]
    },
    "match": {
      "any": [
        {
          "kind": "untraceable",
          "field": "args.to"
        },
        {
          "kind": "untraceable",
          "field": "args.recipient"
        },
        {
          "kind": "untraceable",
          "field": "args.recipients"
        },
        {
          "kind": "untraceable",
          "field": "args.cc"
        },
        {
          "kind": "untraceable",
          "field": "args.bcc"
        },
        {
          "kind": "untraceable",
          "field": "args.email"
        },
        {
          "kind": "untraceable",
          "field": "args.url"
        },
        {
          "kind": "untraceable",
          "field": "args.webhook"
        },
        {
          "kind": "untraceable",
          "field": "args.destination"
        },
        {
          "kind": "untraceable",
          "field": "args.account"
        },
        {
          "kind": "untraceable",
          "field": "args.iban"
        },
        {
          "kind": "untraceable",
          "field": "args.customer_id"
        }
      ]
    },
    "owasp": [
      "ASI01",
      "ASI02",
      "MCP06"
    ],
    "provenance": {
      "author": "human",
      "note": "Lightweight approximation of CaMeL data-flow control"
    }
  },
  {
    "id": "W-TAINT-002",
    "version": 1,
    "description": "Tainted session: a payment or refund amount is not traceable to the user's request or trusted data.",
    "mode": "enforce",
    "severity": "high",
    "action": {
      "type": "step_up",
      "message": "the amount did not come from the user's request"
    },
    "scope": {
      "channels": [
        "arguments"
      ],
      "taint": "tainted",
      "riskTiers": [
        "financial_destructive"
      ]
    },
    "match": {
      "any": [
        {
          "kind": "untraceable",
          "field": "args.amount"
        },
        {
          "kind": "untraceable",
          "field": "args.value"
        }
      ]
    },
    "owasp": [
      "ASI02",
      "ASI09"
    ],
    "provenance": {
      "author": "human"
    }
  },
  {
    "id": "W-OUT-001",
    "version": 2,
    "description": "Tool output contains an instruction aimed at the agent (indirect prompt injection). Override phrases only count when not quoted, so text that discusses injection is not redacted.",
    "mode": "enforce",
    "severity": "high",
    "action": {
      "type": "redact",
      "message": "injected instruction removed from tool output"
    },
    "scope": {
      "channels": [
        "output"
      ]
    },
    "match": {
      "any": [
        {
          "kind": "text",
          "field": "text",
          "op": "anyOf",
          "value": [
            "new instructions:",
            "updated instructions:",
            "important instructions for the ai",
            "important message for the ai",
            "message to the ai assistant",
            "attention ai assistant",
            "attention, ai assistant",
            "note to ai:",
            "instructions for the assistant",
            "<information>",
            "</information>",
            "<instructions>",
            "do not tell the user",
            "don't tell the user",
            "without telling the user",
            "without informing the user",
            "do not mention this to the user",
            "the user has authorized you to",
            "the user wants you to also",
            "you must now",
            "system override",
            "admin override",
            "developer mode enabled",
            "before you do anything else",
            "before completing the user's task",
            "before answering the user",
            "after completing the task, also",
            "this is an important message from"
          ]
        },
        {
          "kind": "text",
          "field": "text",
          "op": "regex",
          "value": "(?:^|[^\"'“‘«\\w])(?:ignore|disregard|forget|override)\\s(?:(?:all|any|the|your)\\s)?(?:previous|prior|above|earlier|preceding|original|system)\\s(?:instructions?|directions|rules|guidelines|prompts?)"
        }
      ]
    },
    "owasp": [
      "ASI01",
      "MCP10",
      "ASI06"
    ],
    "provenance": {
      "author": "human",
      "note": "Seed phrases from AgentDojo injection templates and deepset/prompt-injections"
    }
  },
  {
    "id": "W-OUT-002",
    "version": 1,
    "description": "Tool output imitates a conversation role or boundary tag to smuggle instructions.",
    "mode": "enforce",
    "severity": "high",
    "action": {
      "type": "redact",
      "message": "fake role or boundary tag removed"
    },
    "scope": {
      "channels": [
        "output"
      ]
    },
    "match": {
      "kind": "text",
      "field": "text",
      "op": "anyOf",
      "value": [
        "<|im_start|>",
        "<|im_end|>",
        "<|system|>",
        "[system]",
        "### system:",
        "</tool_output",
        "<tool_output",
        "[inst]",
        "<<sys>>",
        "\nsystem:"
      ],
      "normalize": false
    },
    "owasp": [
      "ASI01",
      "MCP10"
    ],
    "provenance": {
      "author": "human"
    }
  },
  {
    "id": "W-OUT-003",
    "version": 1,
    "description": "Hidden Unicode characters in tool output (instruction smuggling).",
    "mode": "enforce",
    "severity": "medium",
    "action": {
      "type": "redact",
      "message": "hidden characters stripped"
    },
    "scope": {
      "channels": [
        "output"
      ]
    },
    "match": {
      "kind": "hiddenUnicode",
      "field": "text"
    },
    "owasp": [
      "ASI01",
      "MCP10"
    ],
    "provenance": {
      "author": "human"
    }
  },
  {
    "id": "W-OUT-004",
    "version": 1,
    "description": "Secrets and credentials in tool output are redacted before the model sees them.",
    "mode": "enforce",
    "severity": "high",
    "action": {
      "type": "redact",
      "message": "secret redacted"
    },
    "scope": {
      "channels": [
        "output"
      ]
    },
    "match": {
      "kind": "secret",
      "field": "text",
      "types": [
        "aws_access_key",
        "github_token",
        "slack_token",
        "stripe_key",
        "openai_key",
        "anthropic_key",
        "google_api_key",
        "private_key",
        "jwt",
        "connection_string",
        "canary_token"
      ]
    },
    "owasp": [
      "MCP01",
      "MCP10"
    ],
    "provenance": {
      "author": "human"
    }
  },
  {
    "id": "W-OUT-005",
    "version": 1,
    "description": "Encoded (base64, hex, rot13) instruction inside tool output.",
    "mode": "enforce",
    "severity": "high",
    "action": {
      "type": "block",
      "message": "encoded instruction in tool output"
    },
    "scope": {
      "channels": [
        "output"
      ]
    },
    "match": {
      "kind": "decoded",
      "field": "text",
      "encodings": [
        "base64",
        "hex"
      ],
      "anyOf": [
        "ignore previous instructions",
        "ignore all previous",
        "disregard previous",
        "send the",
        "forward the",
        "do not tell the user",
        "new instructions"
      ]
    },
    "owasp": [
      "ASI01",
      "MCP10"
    ],
    "provenance": {
      "author": "human"
    }
  },
  {
    "id": "W-OUT-006",
    "version": 1,
    "description": "Detection cascade is confident the output is an injection.",
    "mode": "enforce",
    "severity": "high",
    "action": {
      "type": "block",
      "message": "detector flagged the output as an injection"
    },
    "scope": {
      "channels": [
        "output"
      ]
    },
    "match": {
      "kind": "detector",
      "layer": "max",
      "gte": 0.92
    },
    "owasp": [
      "ASI01",
      "MCP10"
    ],
    "provenance": {
      "author": "human"
    }
  },
  {
    "id": "W-OUT-007",
    "version": 1,
    "description": "Detection cascade is suspicious of the output: taint the session so later high-risk calls need provenance.",
    "mode": "enforce",
    "severity": "medium",
    "action": {
      "type": "taint_session"
    },
    "scope": {
      "channels": [
        "output"
      ]
    },
    "match": {
      "kind": "detector",
      "layer": "max",
      "gte": 0.5
    },
    "owasp": [
      "ASI01",
      "ASI06"
    ],
    "provenance": {
      "author": "human"
    }
  }
]
