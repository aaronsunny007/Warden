# Copy to .env and adjust. All values are optional; the lab runs with the defaults.

# Admin API bearer token for the gateway (blank = no auth, fine for a local lab).
WARDEN_ADMIN_TOKEN=

# OpenTelemetry collector endpoint. Set this when running `--profile obs`.
# WARDEN_OTLP_ENDPOINT=http://otel-collector:4318

# L3 LLM judge (optional). Point at an Ollama server and name a local model to enable it.
# WARDEN_OLLAMA_URL=http://host.docker.internal:11434
# WARDEN_JUDGE_MODEL=qwen2.5:7b
