{
  "uid": "warden-overview",
  "title": "Warden — Gateway Overview",
  "tags": ["warden"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Verdicts by decision (per second)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "stacking": { "mode": "normal" } } } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (decision) (rate(warden_verdicts_total[1m]))",
          "legendFormat": "{{decision}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Gateway added latency p95 (s), by channel",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, channel) (rate(warden_overhead_seconds_bucket[5m])))",
          "legendFormat": "{{channel}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Tools by status",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "expr": "warden_tools", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Tainted sessions (total)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "expr": "warden_sessions_tainted_total", "legendFormat": "tainted" }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Upstream MCP servers reachable",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "expr": "warden_upstream_up", "legendFormat": "{{server}}" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Top rule hits (per second)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(8, sum by (rule_id) (rate(warden_rule_hits_total[5m])))",
          "legendFormat": "{{rule_id}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Detector unavailable (per second), by channel",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (channel) (rate(warden_detector_unavailable_total[5m]))",
          "legendFormat": "{{channel}}"
        }
      ]
    }
  ]
}
